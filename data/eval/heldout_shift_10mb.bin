fn process_chunk(data: &[u8]) -> Result<Vec<u8>, Error> {
    let mut output = Vec::with_capacity(data.len());
    for &byte in data {
        if byte.is_ascii_alphanumeric() {
            output.push(byte);
        } else {
            output.push(b'_');
        }
    }
    Ok(output)
}

