int process_tokens(const int* tokens, size_t n, int* output) {
    if (tokens == NULL || output == NULL) {
        return -1;
    }
    for (size_t i = 0; i < n; i++) {
        output[i] = tokens[i] ^ 0xFF;
    }
    return 0;
}

