#include <string.h>

typedef struct {
    char* data;
    size_t len;
    size_t cap;
} Buffer;

Buffer* buffer_new(size_t initial_cap) {
    Buffer* buf = malloc(sizeof(Buffer));
    buf->data = malloc(initial_cap);
    buf->len = 0;
    buf->cap = initial_cap;
    return buf;
}

void buffer_free(Buffer* buf) {
    free(buf->data);
    free(buf);
}

