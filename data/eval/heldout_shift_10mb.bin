class TokenEncoder:
    """Encode tokens to integer IDs."""

    def __init__(self, vocab_size: int = 8192):
        self.vocab_size = vocab_size
        self._cache: dict[str, int] = {}

    def encode(self, text: str) -> list[int]:
        tokens = text.split()
        return [hash(t) % self.vocab_size for t in tokens]

