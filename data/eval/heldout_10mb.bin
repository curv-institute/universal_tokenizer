#define MAX_VOCAB_SIZE 65536
#define HASH_SEED 0x9e3779b9

static inline uint32_t hash_string(const char* str) {
    uint32_t h = HASH_SEED;
    while (*str) {
        h = h * 31 + (unsigned char)*str++;
    }
    return h % MAX_VOCAB_SIZE;
}

