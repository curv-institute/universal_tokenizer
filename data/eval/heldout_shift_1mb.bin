            output.push(byte);
        } else {
            output.push(b'_');
        }
    }
    Ok(output)
}

use std::collections::HashMap;

pub struct Tokenizer {
    vocab: HashMap<String, u32>,
    vocab_size: usize,
}

impl Tokenizer {
