#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct TrainConfig {
    pub learning_rate: f64,
    pub batch_size: usize,
    pub max_steps: usize,
    pub seed: u64,
}

impl Default for TrainConfig {
    fn default() -> Self {
        Self {
            learning_rate: 1e-4,
            batch_size: 32,
            max_steps: 10000,
            seed: 42,
        }
    }
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char* data;
    size_t len;
    size_t cap;
} Buffer;

Buffer* buffer_new(size_t initial_cap) {
    Buffer* buf = malloc(sizeof(Buffer));
    buf->data = malloc(initial_cap);
    buf->len = 0;
    buf->cap = initial_cap;
    return buf;
}

void buffer_free(Buffer* buf) {
    free(buf->data);
    free(buf);
}

